generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  NEED_INFORMATION
  APPROVED
  REPORTING
  PLATFORM_REVIEW
  ACTION_TAKEN
  RESOLVED
  REJECTED
  CLOSED
}

enum ContentType {
  POST
  ACCOUNT
  VIDEO
  PHOTO
  OTHER
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String
  role          Role           @default(USER)
  reports       Report[]       @relation("Reporter")
  created       Report[]       @relation("CreatedReports")
  reviews       Review[]
  evidence     Evidence[]
  auditLogs     AuditLog[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Platform {
  id               String            @id @default(uuid())
  name             String            @unique
  code             String            @unique
  baseUrl          String?
  active           Boolean           @default(true)
  reports          Report[]
  policies         Policy[]
  platformReports  PlatformReport[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Report {
  id              String       @id @default(uuid())
  reportCode      String       @unique
  reporterId      String
  createdById     String
  platformId      String
  policyId        String?
  contentType     ContentType
  url             String
  description     String
  priority        Int          @default(2)

  // Jumlah report yang diinginkan.
  reportQuantity  Int          @default(1)

  // Snapshot harga saat report dibuat.
  unitPrice       Int          @default(1500)
  totalPrice      Int          @default(1500)

  status          ReportStatus @default(SUBMITTED)
  deletedAt       DateTime?

  reporter        User          @relation("Reporter", fields: [reporterId], references: [id])
  createdBy       User          @relation("CreatedReports", fields: [createdById], references: [id])
  platform        Platform      @relation(fields: [platformId], references: [id])
  policy          Policy?       @relation(fields: [policyId], references: [id], onDelete: SetNull)
  contents        ReportContent[]
  evidence       Evidence[]
  reviews        Review[]
  platformReport PlatformReport?
  notifications   Notification[]
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ReportContent {
  id                String   @id @default(uuid())
  reportId          String   @unique
  platformContentId String?
  username          String?
  accountName       String?
  caption           String?
  title             String?
  publishedAt       DateTime?
  metadata          Json?
  report            Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Evidence {
  id          String   @id @default(uuid())
  reportId    String
  uploadedBy  String
  fileName    String
  mimeType    String
  fileSize    Int
  storageKey  String
  sha256      String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
}

model Policy {
  id            String   @id @default(uuid())
  platformId    String
  name          String
  description   String
  version       String
  sourceUrl     String?
  effectiveDate DateTime?
  active        Boolean  @default(true)
  platform      Platform @relation(fields: [platformId], references: [id])
  reports       Report[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([platformId, name])
}

model Review {
  id        String   @id @default(uuid())
  reportId  String
  adminId   String
  decision  String
  reason    String?
  notes     String?
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
}

model PlatformReport {
  id                String    @id @default(uuid())
  reportId          String    @unique
  platformId        String
  externalReference String?
  submissionChannel String?
  submittedAt       DateTime?
  status            String?
  response          String?
  lastCheckedAt     DateTime?
  report            Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  platform          Platform  @relation(fields: [platformId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  reportId  String?
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  reportId   String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  user       User?    @relation(fields: [userId], references: [id])
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}
